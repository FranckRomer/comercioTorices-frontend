<!-- Footer -->
<footer class="bg-blue-900 text-white mt-12">
    <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- Company Info -->
            <div>
                <div class="flex items-center mb-4">
                    <div class="w-10 h-10 bg-blue-600 rounded flex items-center justify-center mr-3">
                        <span class="text-white font-bold text-xl">T</span>
                    </div>
                    <span class="text-xl font-bold">TORICES DIGITAL</span>
                </div>
                <div class="mb-4">
                    <input type="email" placeholder="Correo electrónico" class="w-full p-2 rounded text-gray-900 mb-2">
                    <button class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 transition-colors">
                        Suscribirse
                    </button>
                </div>
                <p class="text-sm text-gray-300">
                    17 Princess Road, London, Greater London NW1 8JR, UK
                </p>
            </div>

            <!-- Categories -->
            <div>
                <h3 class="text-lg font-semibold mb-4">Categorías</h3>
                <ul class="space-y-2 text-sm">
                    <li><a href="#" class="text-gray-300 hover:text-white">Laptops & Computers</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Cameras & Photography</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Smart Phones & Tablets</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Video Games & Consoles</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Waterproof Headphones</a></li>
                </ul>
            </div>

            <!-- My Account -->
            <div>
                <h3 class="text-lg font-semibold mb-4">Mi cuenta</h3>
                <ul class="space-y-2 text-sm">
                    <li><a href="#" class="text-gray-300 hover:text-white">My Account</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Discount</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Returns</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Orders History</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Order Tracking</a></li>
                </ul>
            </div>

            <!-- Pages -->
            <div>
                <h3 class="text-lg font-semibold mb-4">Páginas</h3>
                <ul class="space-y-2 text-sm">
                    <li><a href="#" class="text-gray-300 hover:text-white">Blog</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Browse the Shop</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Category</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Pre-Built Pages</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">Visual Composer Elements</a></li>
                    <li><a href="#" class="text-gray-300 hover:text-white">WooCommerce Pages</a></li>
                </ul>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="border-t border-blue-800 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
            <p class="text-sm text-gray-300">©Torices Digital - All Rights Reserved</p>
            <div class="flex space-x-4 mt-4 md:mt-0">
                <a href="#" class="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center hover:bg-red-700 transition-colors">
                    <i class="fab fa-facebook-f text-sm"></i>
                </a>
                <a href="#" class="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center hover:bg-red-700 transition-colors">
                    <i class="fab fa-instagram text-sm"></i>
                </a>
                <a href="#" class="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center hover:bg-red-700 transition-colors">
