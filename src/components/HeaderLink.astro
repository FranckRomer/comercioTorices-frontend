---
export interface Props {
    href: string;
    onclick?: string;
}

const { href, onclick, ...rest } = Astro.props;
---

<a
    href={href}
    onclick={onclick}
    class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
    {...rest}
>
    <slot />
</a>
