---

---

<!-- Header -->
<header class="bg-white shadow-sm">
    <!-- Top Bar -->
    <div class="bg-blue-900 text-white py-2">
        <div
            class="container mx-auto px-4 flex justify-between items-center text-sm"
        >
            <div class="flex items-center space-x-4">
                <span
                    ><i class="fas fa-envelope mr-1"></i> ventas@toricesdigital.com</span
                >
                <span><i class="fas fa-phone mr-1"></i> (12345)67890</span>
            </div>
            <div class="flex items-center space-x-4">
                <a href="#" class="hover:text-blue-200">Entrar</a>
                <a href="#" class="hover:text-blue-200"
                    ><i class="fas fa-heart mr-1"></i>Favoritos</a
                >
                <a href="#" class="hover:text-blue-200"
                    ><i class="fas fa-shopping-cart"></i></a
                >
            </div>
        </div>
    </div>

    <!-- Main Navigation -->
    <div class="bg-white py-4">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <!-- Logo -->
            <div class="flex items-center">
                <div
                    class="w-10 h-10 bg-blue-600 rounded flex items-center justify-center mr-3"
                >
                    <span class="text-white font-bold text-xl">T</span>
                </div>
                <span class="text-2xl font-bold text-blue-600"
                    >TORICES DIGITAL</span
                >
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex space-x-8">
                <a
                    href="#"
                    class="text-blue-600 hover:text-blue-800 flex items-center"
                >
                    Home <i class="fas fa-chevron-down ml-1 text-xs"></i>
                </a>
                <a href="#" class="text-gray-700 hover:text-blue-600"
                    >Productos</a
                >
                <a href="#" class="text-gray-700 hover:text-blue-600">Blog</a>
                <a href="#" class="text-gray-700 hover:text-blue-600">Tienda</a>
                <a href="#" class="text-gray-700 hover:text-blue-600"
                    >Contacto</a
                >
            </nav>

            <!-- Search Bar -->
            <div class="relative">
                <input
                    type="text"
                    placeholder="Buscar..."
                    class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <i class="fas fa-search absolute left-3 top-3 text-gray-400"
                ></i>
            </div>
        </div>
    </div>
</header>
