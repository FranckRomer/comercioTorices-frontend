---
import Layout from "../layouts/Layout.astro";
import { Cart } from "../components/Cart";
---

<Layout title="Carrito de Compras - Torices Digital" description="Revisa y gestiona los productos en tu carrito de compras">
	<!-- Main Content -->
	<div class="container mx-auto px-4 py-8">
		<!-- Page Title and Breadcrumbs -->
		<div class="mb-8">
			<h1 class="text-4xl font-bold text-blue-900 mb-4">Carrito de compras</h1>
			<nav class="text-blue-600 text-sm">
				<a href="/" class="hover:text-blue-800">Inicio</a> . 
				<span class="text-gray-500">Carrito de compras</span>
			</nav>
		</div>

		<!-- Test Button -->
		<div class="mb-4">
			<button 
				id="add-test-product" 
				class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
			>
				Agregar Producto de Prueba
			</button>
		</div>

		<!-- React Cart Component -->
		<Cart client:load />

		<script>
			// Add test product to cart
			document.getElementById('add-test-product')?.addEventListener('click', () => {
				const testProduct = {
					id: 1,
					name: "Panel Metcoppo",
					price: 42,
					originalPrice: 32,
					image: "/img/Panel Metcoppo.png",
					category: "Paneles",
					sku: "00001",
					options: {
						color: "Azul",
						length: "3 metros",
						thickness: "2mm"
					}
				};

				// Get existing cart
				const existingCart = JSON.parse(localStorage.getItem('torices_cart') || '[]');
				
				// Check if product already exists
				const existingItem = existingCart.find((item: any) => item.id === testProduct.id);
				
				if (existingItem) {
					existingItem.quantity += 1;
				} else {
					existingCart.push({ ...testProduct, quantity: 1 });
				}
				
				// Save to localStorage
				localStorage.setItem('torices_cart', JSON.stringify(existingCart));
				
				// Emit event to update components
				window.dispatchEvent(new CustomEvent('cartUpdated'));
				
				// Reload page to show updated cart
				window.location.reload();
			});
		</script>
	</div>
</Layout>