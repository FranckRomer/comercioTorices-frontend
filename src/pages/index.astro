---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Lámina Poliacryl - Torices Digital</title>
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
	</head>
	<body class="bg-gray-50">
		<Header />

		<!-- Main Content -->
		<main class="container mx-auto px-4 py-8">
			<!-- Product Section -->
			<div class="bg-white rounded-lg shadow-sm p-8 mb-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
					<!-- Product Images -->
					<div class="flex gap-4 h-full">
						<!-- Thumbnails - 1/6 del espacio -->
						<div class="w-1/6 flex flex-col gap-2 h-full justify-center">
							<div class="w-full h-20 bg-white rounded border border-gray-300 hover:border-blue-500 cursor-pointer overflow-hidden">
                                <img src="/public/img/lamina-amarilla.png" alt="Product Image" class="w-full h-full object-cover" />
                            </div>
							<div class="w-full h-20 bg-white rounded border border-gray-300 hover:border-blue-500 cursor-pointer overflow-hidden">
                                <img src="/public/img/lamina-blanca.png" alt="Product Image" class="w-full h-full object-cover" />
                            </div>
							<div class="w-full h-20 bg-gray-300 rounded border border-gray-300 hover:border-blue-500 cursor-pointer overflow-hidden">
                                <img src="/public/img/lamina-verde.png" alt="Product Image" class="w-full h-full object-cover" />
                            </div>
						</div>
						<!-- Main Image - 5/6 del espacio -->
						<div class="w-5/6 bg-gray-100 rounded-lg flex items-center justify-center">
							<div class="w-full h-full bg-white rounded shadow-lg flex items-center justify-center overflow-hidden">
								<img src="/public/img/lamina-principal.png" alt="Product Image" class="w-full h-full object-contain" />
							</div>
						</div>
					</div>

					<!-- Product Info -->
					<div class="space-y-6">
						<h1 class="text-3xl font-bold text-blue-900">Lámina Poliacryl</h1>
						
						<!-- Rating -->
						<div class="flex items-center space-x-2">
							<div class="flex text-yellow-400">
								<i class="fas fa-star"></i>
								<i class="fas fa-star"></i>
								<i class="fas fa-star"></i>
								<i class="fas fa-star"></i>
								<i class="fas fa-star"></i>
							</div>
							<span class="text-gray-600">(22)</span>
						</div>

						<!-- Price -->
						<div class="space-y-2">
							<span class="text-lg text-gray-500 line-through">$32.00</span>
							<div class="text-3xl font-bold text-blue-900">$42.00</div>
						</div>

						<!-- Description -->
						<p class="text-gray-600 leading-relaxed">
							Lamina poliacryl estabilizada de 2mm de espesor. Con revestimiento de aluminio especial para proteger la lamina de la intemperie.
						</p>

						<!-- Options -->
						<div class="space-y-4">
							<!-- Color -->
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-2">Color:</label>
								<div class="flex space-x-2">
									<div class="w-8 h-8 bg-yellow-400 rounded border-2 border-blue-500 cursor-pointer"></div>
									<div class="w-8 h-8 bg-green-400 rounded border border-gray-300 cursor-pointer"></div>
								</div>
							</div>

							<!-- Length -->
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-2">Largo:</label>
								<select class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
									<option>Seleccionar largo</option>
									<option>2 metros</option>
									<option>3 metros</option>
									<option>4 metros</option>
								</select>
							</div>

							<!-- Thickness -->
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-2">Espesor:</label>
								<select class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
									<option>Seleccionar espesor</option>
									<option>2mm</option>
									<option>3mm</option>
									<option>4mm</option>
								</select>
							</div>
						</div>

						<!-- Add to Cart Button -->
						<button class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center space-x-2">
							<i class="fas fa-shopping-cart"></i>
							<span>Agregar Al Carrito</span>
							<i class="fas fa-heart"></i>
						</button>

						<!-- Product Details -->
						<div class="pt-4 border-t border-gray-200">
							<div class="flex justify-between text-sm">
								<span class="text-gray-600">Categoría:</span>
								<span class="text-gray-900">Láminas</span>
							</div>
							<div class="flex justify-between text-sm">
								<span class="text-gray-600">SKU:</span>
								<span class="text-gray-900">00003</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Product Details Tabs -->
			<div class="bg-blue-50 rounded-lg p-8 mb-8">
				<!-- Tabs -->
				<div class="flex space-x-8 mb-6">
					<button class="text-blue-600 border-b-2 border-blue-600 pb-2 font-medium">Descripción</button>
					<button class="text-gray-600 hover:text-blue-600 pb-2">Información adicional</button>
					<button class="text-gray-600 hover:text-blue-600 pb-2">Reseñas</button>
					<button class="text-gray-600 hover:text-blue-600 pb-2">Video</button>
				</div>

				<!-- Tab Content -->
				<div>
					<h3 class="text-xl font-bold text-blue-900 mb-4">Lámina Poliacryl Stabilit</h3>
					<div class="space-y-4 text-gray-600 leading-relaxed">
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
						<p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
					</div>

					<h4 class="text-lg font-bold text-blue-900 mt-6 mb-4">Más detalles</h4>
					<ul class="space-y-2 text-gray-600">
						<li class="flex items-start">
							<i class="fas fa-arrow-right text-blue-600 mr-2 mt-1"></i>
							<span>Lorem ipsum dolor sit amet, consectetur adipiscing elit</span>
						</li>
						<li class="flex items-start">
							<i class="fas fa-arrow-right text-blue-600 mr-2 mt-1"></i>
							<span>Sed do eiusmod tempor incididunt ut labore et dolore</span>
						</li>
						<li class="flex items-start">
							<i class="fas fa-arrow-right text-blue-600 mr-2 mt-1"></i>
							<span>Ut enim ad minim veniam, quis nostrud exercitation</span>
						</li>
						<li class="flex items-start">
							<i class="fas fa-arrow-right text-blue-600 mr-2 mt-1"></i>
							<span>Duis aute irure dolor in reprehenderit in voluptate</span>
						</li>
					</ul>
				</div>
			</div>

			<!-- Related Products -->
			<div class="bg-white rounded-lg shadow-sm p-8">
				<h2 class="text-2xl font-bold text-blue-900 mb-6">Productos relacionados</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					<!-- Product Card 1 -->
					<div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-lg transition-shadow">
						<div class="relative">
							<div class="w-full h-48 bg-green-200 hover:bg-yellow-200 rounded mb-4">
                                <img src="/public/img/Panel Metcoppo.png" alt="Product Image" class="w-full h-full object-cover" />
                            </div>
							<div class="absolute top-2 right-2 flex space-x-2">
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-shopping-cart text-gray-600"></i>
								</button>
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-search text-gray-600"></i>
								</button>
							</div>
						</div>
						<h3 class="font-semibold text-gray-900 mb-2">Panel Metcoppo</h3>
						<p class="text-sm text-gray-600 mb-2">SKU-00001</p>
						<p class="text-lg font-bold text-blue-900">$42.00</p>
						<button class="w-full mt-3 bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition-colors">
							Ver detalles
						</button>
					</div>

					<!-- Product Card 2 -->
					<div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-lg transition-shadow">
						<div class="relative">
							<div class="w-full h-48 bg-green-200 hover:bg-yellow-200 rounded mb-4">
                                <img src="/public/img/Lamina Tablero.png" alt="Product Image" class="w-full h-full object-cover" />
                            </div>
							<div class="absolute top-2 right-2 flex space-x-2">
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-shopping-cart text-gray-600"></i>
								</button>
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-search text-gray-600"></i>
								</button>
							</div>
						</div>
						<h3 class="font-semibold text-gray-900 mb-2">Lámina Tablero</h3>
						<p class="text-sm text-gray-600 mb-2">SKU-00002</p>
						<p class="text-lg font-bold text-blue-900">$42.00</p>
						<button class="w-full mt-3 bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition-colors">
							Ver detalles
						</button>
					</div>

					<!-- Product Card 3 -->
					<div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-lg transition-shadow">
						<div class="relative">
							<div class="w-full h-48 bg-green-200 hover:bg-yellow-200 rounded mb-4">
                                <img src="/public/img/Poliacryl.png" alt="Product Image" class="w-full h-full object-cover" />
                            </div>
							<div class="absolute top-2 right-2 flex space-x-2">
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-shopping-cart text-gray-600"></i>
								</button>
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-search text-gray-600"></i>
								</button>
							</div>
						</div>
						<h3 class="font-semibold text-gray-900 mb-2">Poliacryl</h3>
						<p class="text-sm text-gray-600 mb-2">SKU-00003</p>
						<p class="text-lg font-bold text-blue-900">$42.00</p>
						<button class="w-full mt-3 bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition-colors">
							Ver detalles
						</button>
					</div>

					<!-- Product Card 4 -->
					<div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-lg transition-shadow">
						<div class="relative">
							<div class="w-full h-48 bg-green-200 hover:bg-yellow-200 rounded mb-4">
                                <img src="/public/img/Alambre Galvanizado.png" alt="Product Image" class="w-full h-full object-cover" />
                            </div>
							<div class="absolute top-2 right-2 flex space-x-2">
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-shopping-cart text-gray-600"></i>
								</button>
								<button class="w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-sm hover:bg-blue-50">
									<i class="fas fa-search text-gray-600"></i>
								</button>
							</div>
						</div>
						<h3 class="font-semibold text-gray-900 mb-2">Alambre Galvanizado</h3>
						<p class="text-sm text-gray-600 mb-2">SKU-00004</p>
						<p class="text-lg font-bold text-blue-900">$42.00</p>
						<button class="w-full mt-3 bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition-colors">
							Ver detalles
						</button>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
