---
import Layout from "../layouts/Layout.astro";
import { ProductGrid } from "../components/ProductGrid";
import productsData from "../data/products.json";

const products = productsData;
---

<Layout title="Torices Digital - Productos de Construcción" description="Encuentra los mejores productos de construcción para tu proyecto">
	<!-- Hero Section -->
	<div class="container mx-auto px-4 py-8">
		<div class="bg-gradient-to-r from-blue-600 to-blue-800 rounded-lg p-8 mb-8 text-white">
			<h1 class="text-4xl font-bold mb-4">Bienvenido a Torices Digital</h1>
			<p class="text-xl mb-6">Encuentra los mejores productos de construcción para tu proyecto</p>
			<a href="/productos">
				<button class="bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors">
					Ver Productos
				</button>
			</a>
		</div>

		<!-- Products Grid -->
		<div class="bg-white rounded-lg shadow-sm p-8">
			<h2 class="text-2xl font-bold text-blue-900 mb-6">Nuestros Productos</h2>
			<ProductGrid products={products} client:load />
		</div>

		<!-- Features Section -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
			<div class="bg-white rounded-lg shadow-sm p-6 text-center">
				<div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
					<i class="fas fa-shipping-fast text-blue-600 text-2xl"></i>
				</div>
				<h3 class="text-lg font-semibold text-gray-900 mb-2">Envío Rápido</h3>
				<p class="text-gray-600">Entregas en 24-48 horas en toda la ciudad</p>
			</div>
			<div class="bg-white rounded-lg shadow-sm p-6 text-center">
				<div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
					<i class="fas fa-shield-alt text-blue-600 text-2xl"></i>
				</div>
				<h3 class="text-lg font-semibold text-gray-900 mb-2">Garantía</h3>
				<p class="text-gray-600">Productos con garantía de calidad</p>
			</div>
			<div class="bg-white rounded-lg shadow-sm p-6 text-center">
				<div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
					<i class="fas fa-headset text-blue-600 text-2xl"></i>
				</div>
				<h3 class="text-lg font-semibold text-gray-900 mb-2">Soporte</h3>
				<p class="text-gray-600">Atención al cliente 24/7</p>
			</div>
		</div>
	</div>
</Layout>